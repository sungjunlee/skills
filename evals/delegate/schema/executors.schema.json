{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sungjunlee/skills/evals/delegate/schema/executors.schema.json",
  "title": "Delegate evaluation executor registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "executors"],
  "properties": {
    "contract_version": { "const": "delegate-eval-v1" },
    "executors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "executor_id",
          "match_models",
          "availability",
          "list_models",
          "dispatch",
          "effort_argv",
          "supported_efforts"
        ],
        "properties": {
          "executor_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "match_models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "availability": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "list_models": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            ]
          },
          "dispatch": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "effort_argv": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            ]
          },
          "supported_efforts": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["minimal", "low", "medium", "high", "xhigh", "max"] }
              }
            ]
          }
        }
      }
    }
  }
}
